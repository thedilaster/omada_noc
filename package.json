{
  "name": "noc_dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && npm run lint && npm run test:coverage && next build",
    "start": "next start",
    "lint": "eslint",
    "mcp": "tsx mcp/cli.ts",
    "mcp:agent": "tsx scripts/mcp-agent.ts",
    "mcp:copilot": "tsx scripts/mcp-copilot.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector tsx mcp/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:controller": "tsx scripts/test-controller.ts",
    "test:integration": "OMADA_INTEGRATION=1 vitest run tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
