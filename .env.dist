# Omada controller (use a dedicated read-only/viewer account if you can)
OMADA_URL=https://<your-omada-ip>
OMADA_USER=your_username
OMADA_PASS=your_password
# Site name or ID as shown in the controller UI
OMADA_SITE=Default
# Only "true" disables TLS verification (needed for the controller's self-signed cert)
OMADA_ALLOW_INSECURE_SSL=true
# Per-request controller timeout in ms (default 8000)
# OMADA_TIMEOUT_MS=

# Database (scripts/podman-up.sh runs Postgres in the same pod, so localhost works)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/noc_dash

# Auth — JWT_SECRET is required in production (>= 32 chars): openssl rand -base64 48
JWT_SECRET=
DEFAULT_ADMIN_EMAIL=admin@omadanoc.com
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-on-first-login
# Session cookie "Secure" flag: auto-detected from the request (https / x-forwarded-proto); force with true/false
# COOKIE_SECURE=
# In-memory DB fallback when Postgres is unreachable: on in dev, off in production unless set to true
# ALLOW_MEMORY_FALLBACK=

# Optional: local Ollama for the DeepSeek AI audit engine
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=deepseek-r1:7b
# OLLAMA_TIMEOUT_MS=120000
